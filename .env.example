# minibot 配置文件
# 复制此文件为 .env 然后填入你的 API Key
# 注意：.env 已在 .gitignore 中，不会提交到 Git

# ── LLM 配置 ──────────────────────────────────

# 必须：LLM API Key
LLM_API_KEY="sk-你的key"

# 可选：API 地址（默认 OpenAI）
LLM_BASE_URL="https://api.deepseek.com/v1"

# 可选：模型名称
LLM_MODEL="deepseek-v4-flash"

# ── 网关配置（可选） ──────────────────────────

# 微信通道（首次运行会自动扫码登录并保存凭证）
# WECHAT_ACCOUNT_ID=
# WECHAT_TOKEN=
# WECHAT_BASE_URL=https://ilinkai.weixin.qq.com
# WECHAT_DM_POLICY=open
# WECHAT_ALLOWED_USERS=

# 启动哪些通道（逗号分隔）
# GATEWAY_CHANNELS=wechat
